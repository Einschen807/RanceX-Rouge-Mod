; Godot 4.7.2 title-screen recreation.
config_version=5

[application]
config/name="Rance Rouge Mod"
config/use_custom_user_dir=true
config/custom_user_dir_name="Godot/app_userdata/兰斯10 · 标题界面"
boot_splash/show_image=false
run/main_scene="res://scenes/title_screen.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]
BGM="*res://scenes/bgm_manager.tscn"
UIAudio="*res://scripts/audio/ui_audio.gd"
RunAutosave="*res://scripts/run/run_autosave.gd"
Settings="*res://scripts/settings/shared_settings.gd"
BattleManager="*res://scripts/battle/battle_manager.gd"
ShopManager="*res://scripts/shop/shop_manager.gd"
RunSession="*res://scripts/run/run_session.gd"
EventManager="*res://scripts/event/event_manager.gd"
DebugConsole="*res://scripts/debug/debug_console.gd"
RelicHUD="*res://scripts/relic/relic_hud.gd"
ScreenSettings="*res://scripts/settings/screen_settings.gd"
ScreenTransition="*res://scripts/core/screen_transition.gd"

[display]
window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1280
window/size/window_height_override=720
window/size/min_width=960
window/size/min_height=540
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[input]
ui_cancel={
"deadzone": 0.5,
"events": [Object(InputEventKey,"keycode":4194305), Object(InputEventMouseButton,"button_index":2)]
}

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.015, 0.018, 0.022, 1)
